	padding-bottom: var(--padding-bottom);
	padding-left: var(--padding-left);
}

.e-con-boxed.e-flex {
	place-content: normal;
	align-items: normal;
	flex-flow: column;
}

.e-con-boxed {
	gap: initial;
	text-align: initial;
}

